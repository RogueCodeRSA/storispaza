      {
        "number": 3,
        "title": "A complete path",
        "narrative": "The teacher closed the kit's switch. Its tiny lamp lit up. A complete circuit makes a path for electric current, the teacher explained.",
        "illustrationDescription": "An adult pointing to the closed switch on an enclosed battery classroom kit.",
        "characterRefs": [
          "girl"
        ],
        "learningMoment": "A closed circuit provides a complete path for current.",
