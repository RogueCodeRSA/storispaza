# Copy to .env.local. No keys or network are needed in mock mode.
AI_PROVIDER=mock
# Real adapter is intentionally unavailable in M0. Configure only when M2 is approved.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
DATA_DIR=./data
SESSION_BUDGET_USD=2
DEVELOPMENT_BUDGET_USD=10
AI_REQUESTS_PER_MINUTE=10
NEXT_TELEMETRY_DISABLED=1
