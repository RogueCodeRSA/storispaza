# Copy to ignored .env.local. Never put actual credentials in this example.
AI_PROVIDER=mock
AI_ADAPTER=openai
# Explicit activation only after access/CI gates; mock remains the demo default.
ENABLE_LIVE_AI=0
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
DATA_DIR=./data
SESSION_BUDGET_USD=2
DEVELOPMENT_BUDGET_USD=10
AI_REQUESTS_PER_MINUTE=10
IMAGE_ATTEMPT_LIMIT=20
NEXT_TELEMETRY_DISABLED=1
