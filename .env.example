# Optional in a fresh checkout: copy to ignored .env.local.
# Never overwrite the creator's existing file or put credentials in this example.
# Mock runtime needs no keys/network. Never use NEXT_PUBLIC_ for a secret.
AI_PROVIDER=mock
AI_ADAPTER=openai
# Explicit activation only after access/CI gates; mock remains the demo default.
ENABLE_LIVE_AI=0
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# Private, unencrypted SQLite; keep evaluation data separate from recording work.
DATA_DIR=./data
SESSION_BUDGET_USD=2
DEVELOPMENT_BUDGET_USD=10
AI_REQUESTS_PER_MINUTE=10
# Hard maximum across sessions, including failed/ambiguous dispatches; lower only.
IMAGE_ATTEMPT_LIMIT=20
NEXT_TELEMETRY_DISABLED=1
